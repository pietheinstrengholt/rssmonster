# Optional shared secret; configure the exact same value on server and inference.
# Generate one with: openssl rand -hex 32
# INFERENCE_API_KEY=
# Local inference service network configuration.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=3001
INFERENCE_DEBUG=false
INFERENCE_MODEL_CACHE_DIR=.cache/models
# Assistant request rate limiting.
ASSISTANT_RATE_LIMIT_WINDOW_MS=900000
ASSISTANT_RATE_LIMIT_MAX=100
# Supported values: local, openai-compatible.
EMBEDDING_PROVIDER=local
# Supported values: local, openai-compatible.
GENERATION_PROVIDER=local
# Supported values: local, openai-compatible.
CLASSIFICATION_PROVIDER=local
# Optional assistant: uncomment all four settings to enable its compatible endpoint.
# ASSISTANT_PROVIDER=openai-compatible
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_API_KEY=your-openai-api-key
# ASSISTANT_MODEL=gpt-4o-mini

# Local generation configuration.
GENERATION_MODEL=onnx-community/Qwen3.5-0.8B-ONNX
GENERATION_DTYPE=q4
# One Qwen job runs while at most four wait in memory.
GENERATION_QUEUE_MAX_PENDING=4

# Local article scoring configuration.
CLASSIFICATION_MODEL=onnx-community/ModernBERT-base-nli-ONNX
MODERNBERT_DTYPE=q8
# One ModernBERT scoring job runs while at most four wait in memory.
MODERNBERT_QUEUE_MAX_PENDING=4

# Local embedding configuration.
EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_BATCH_SIZE=8
# One Qwen embedding job runs while at most four wait in memory.
EMBEDDING_QUEUE_MAX_PENDING=4

# For any remote capability, select openai-compatible and set its endpoint, key, and model.
# Example mixed deployment (replace the corresponding local settings above):
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS=1024
# GENERATION_PROVIDER=openai-compatible
# GENERATION_BASE_URL=http://lmstudio:1234/v1
# GENERATION_API_KEY=lmstudio
# GENERATION_MODEL=qwen3.5-4b
# CLASSIFICATION_PROVIDER=openai-compatible
# CLASSIFICATION_BASE_URL=https://api.openai.com/v1
# CLASSIFICATION_API_KEY=your-classification-api-key
# CLASSIFICATION_MODEL=gpt-4o-mini

# Optional remote workload overrides of GENERATION_MODEL; all use the generation endpoint/key.
# GENERATION_ARTICLE_MODEL=gpt-4o-mini
# GENERATION_SMART_FOLDER_MODEL=gpt-4.1-mini
# GENERATION_FEED_REDISCOVERY_MODEL=gpt-4.1-mini
# Omit the temperature field from Chat Completions requests only when required by the gateway/model.
OPENAI_OMIT_TEMPERATURE=false
# ASSISTANT_REASONING_EFFORT belongs in server/.env.

# Legacy OPENAI_* connection/model settings, qwen/openai provider names, and
# ARTICLE_SCORING_PROVIDER/MODERNBERT_MODEL remain aliases for one release.
# See docs/inference.md for precedence and fully local/external migration examples.

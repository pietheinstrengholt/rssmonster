{
  "name": "rssmonster-inference",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "RSSMonster inference service",
  "main": "src/index.js",
  "scripts": {
    "dev": "INFERENCE_DEBUG=true node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.js' --coverage.thresholds.80 --coverage.thresholds.perFile",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@openai/agents": "^0.17.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}

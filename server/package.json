{
  "name": "rssmonster-server",
  "version": "2.2.0",
  "type": "module",
  "description": "RSS Monster server side",
  "author": "Piethein Strengholt",
  "repository": {
    "type": "git",
    "url": "https://github.com/pietheinstrengholt/rssmonster"
  },
  "main": "bootstrap.js",
  "scripts": {
    "test": "vitest run",
    "test:debug": "RSSMONSTER_TEST_DEBUG=true vitest run",
    "test:sqlite": "vitest run tests/config tests/models tests/migrations tests/articleSearch tests/workers tests/app/health.test.js tests/app/express.smoke.test.js tests/controllers/feedObservability.controller.test.js",
    "test:semantic-report": "vitest run tests/semantic",
    "test:semantic-trace": "RSSMONSTER_TEST_DEBUG=true SEMANTIC_REPORT_LEVEL=trace vitest run tests/semantic",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:semantic-ad-event": "vitest run tests/semantic/semanticRegression.incremental.adEvent.test.js",
    "fixture:semantic-export": "node scripts/exportSemanticRegressionFixture.js",
    "fixture:semantic-vectors": "node scripts/generateSemanticRegressionVectors.js",
    "fixture:semantic-incremental-vectors": "node scripts/generateSemanticRegressionIncrementalVectors.js",
    "fixture:semantic-incremental-unread-vectors": "node scripts/generateSemanticRegressionIncrementalUnreadVectors.js",
    "fixture:taxonomy-vectors": "node scripts/generateIslandTaxonomyVectorFixture.js",
    "fixture:semantic-select": "node scripts/selectSemanticVectorModel.js",
    "lint": "eslint .",
    "start": "node bootstrap.js",
    "start-server": "node bootstrap.js",
    "start:worker": "NODE_ENV=production node src/workers/crawlWorker.js",
    "start:ai-worker": "NODE_ENV=production node src/workers/aiWorker.js",
    "jobs:operator": "NODE_ENV=production node scripts/manageProcessingJobs.js",
    "dev": "node --watch --watch-path=./app.js --watch-path=./controllers --watch-path=./routes --watch-path=./models --watch-path=./middleware --watch-path=./services --watch-path=./utils --watch-path=./config bootstrap.js",
    "debug": "node --inspect --watch --watch-path=./app.js --watch-path=./controllers --watch-path=./routes --watch-path=./models --watch-path=./middleware --watch-path=./services --watch-path=./utils --watch-path=./config bootstrap.js",
    "db": "./node_modules/.bin/sequelize db:migrate",
    "crawl": "NODE_ENV=production node scripts/runSemanticPipeline.js",
    "crawl:recover": "NODE_ENV=production node scripts/recoverCrawlRuns.js",
    "semantic:repair": "NODE_ENV=production node scripts/repairSemanticPipeline.js",
    "semantic:all": "NODE_ENV=production node scripts/rebuildSemanticPipeline.js",
    "semantic:model-rebuild": "NODE_ENV=production node scripts/rebuildSemanticForEmbeddingModel.js",
    "events": "node scripts/runEventsCommand.js",
    "events:backfill": "node scripts/backfillHistoricalEventArticles.js --skipTopicAssignment",
    "topics": "node scripts/runTopicsCommand.js",
    "feedtrust": "NODE_ENV=production node scripts/calculateFeedTrust.js",
    "islands": "NODE_ENV=production node scripts/runIslandsCommand.js",
    "backfill:engaged-vectors": "NODE_ENV=production node scripts/backfillEngagedArticleVectors.js",
    "taxonomy:vectors": "node scripts/generateIslandTaxonomyVectors.js",
    "taxonomy:evaluate": "node scripts/evaluateTaxonomyEmbeddingStrategies.js",
    "seed:island-taxonomy": "./node_modules/.bin/sequelize db:seed --seed 20260520104500-island-taxonomy.js",
    "seed:undo:island-taxonomy": "./node_modules/.bin/sequelize db:seed:undo --seed 20260520104500-island-taxonomy.js",
    "seed:official-sources": "NODE_ENV=production node scripts/seedOfficialSources.js",
    "hotlinks": "NODE_ENV=production node scripts/rebuildHotlinks.js",
    "repair-duplicates": "NODE_ENV=production node scripts/repairDuplicateCounts.js",
    "reset:semantic": "node scripts/resetSemanticState.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.17.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "feedsmith": "^2.9.6",
    "franc-min": "^6.2.0",
    "he": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "mysql2": "3.24.2",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "undici": "^8.10.1",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}

# This is an example configuration file for RSS Monster. Copy this file to .env and edit the values as needed.
# Database configuration.
DB_DIALECT=mysql
DB_HOSTNAME=localhost
DB_PORT=3306
DB_DATABASE=rssmonster
DB_USERNAME=rssmonster
DB_PASSWORD=password
# For SQLite, set DB_DIALECT=sqlite and provide a storage path instead of the MySQL variables above.
# DB_STORAGE=./data/rssmonster.sqlite
# Node environment: development, production, test.
NODE_ENV=development
ENABLE_DEVELOPMENT_LOGIN=false
DEVELOPMENT_LOGIN_USER_ID=
# Space-separated host[:port] or CIDR exceptions for trusted internal feeds.
RSSMONSTER_INTERNAL_HOST_ALLOWLIST=
# FEED processing configuration.
FEED_MAX_COUNT=100
FEED_PARALLEL_CONCURRENCY=3
FEED_RESPONSE_MAX_BYTES=10485760
FEED_TIMEOUT_MS=60000
FEED_LEASE_MS=120000
FEED_ORIGIN_MAX_CONCURRENCY=2
FEED_ORIGIN_MIN_SPACING_MS=250
FEED_CACHE_FRESHNESS_MAX_MS=86400000
FEED_RETRY_AFTER_MAX_MS=604800000
FEED_PARSER_TIMEOUT_MS=2000
FEED_PARSER_MEMORY_MB=64
FEED_MAX_ENTRIES=1000
FEED_MAX_GUID_BYTES=4096
FEED_MAX_URL_BYTES=8192
FEED_MAX_TITLE_BYTES=4096
FEED_MAX_AUTHOR_BYTES=2048
FEED_MAX_CONTENT_BYTES=2097152
FEED_CONNECT_TIMEOUT_MS=10000
FEED_BODY_TIMEOUT_MS=30000
# Crawl execution and scheduling configuration.
CRAWL_TIMEOUT_MS=600000
CRAWL_DUPLICATE_CACHE_DAYS=30
CRAWL_RUN_HEARTBEAT_INTERVAL_MS=30000
CRAWL_RUN_STALE_AFTER_MS=120000
CRAWL_USER_BATCH_SIZE=5
CRAWL_PARALLELPROCESSFLAG=0
# Poll for another complete crawl run every 60 seconds.
CRAWL_WORKER_INTERVAL_MS=60000
# Configure durable optional-job consumption in rssmonster-ai-worker.
PROCESSING_JOB_POLL_INTERVAL_MS=1000
# Defaults to one and is always forced to one on SQLite.
PROCESSING_JOB_CONCURRENCY=1
PROCESSING_JOB_SHUTDOWN_TIMEOUT_MS=30000
PROCESSING_JOB_REPORT_INTERVAL_MS=60000
# Cross-process crawl priority and AI-worker health.
CRAWL_PRIORITY_LEASE_MS=90000
CRAWL_PRIORITY_HEARTBEAT_MS=30000
AI_WORKER_HEALTH_FILE=/tmp/rssmonster-ai-worker-health.json
AI_WORKER_HEALTH_MAX_FAILURES=3
AI_WORKER_HEALTH_MAX_STALE_MS=900000
# Mark the worker unhealthy after 3 consecutive failures or 15 minutes without a state update.
CRAWL_WORKER_HEALTH_MAX_FAILURES=3
CRAWL_WORKER_HEALTH_MAX_STALE_MS=900000
# Emit candidate, retry, and discovery diagnostics in addition to final crawl results.
CRAWL_VERBOSE_LOGGING=false
# JWT and Fever credentials.
JWT_EXPIRES_IN=604800
JWT_SECRET=replace-with-a-long-random-secret
FEVER_CREDENTIAL_SECRET=replace-with-a-different-long-random-secret
# API and MCP rate limiting.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
MCP_RATE_LIMIT_WINDOW_MS=900000
MCP_RATE_LIMIT_MAX=100
# Use loopback for a same-host proxy, a hop count, or trusted proxy addresses.
TRUST_PROXY=loopback
# Standalone service used for all model inference.
INFERENCE_URL=http://127.0.0.1:3001
INFERENCE_TIMEOUT_MS=30000
INFERENCE_AGENT_TIMEOUT_MS=300000
# Open an affected capability's server-side circuit after five consecutive availability failures.
INFERENCE_CIRCUIT_FAILURE_THRESHOLD=5
# Wait at least 30 seconds before allowing one recovery probe.
INFERENCE_CIRCUIT_COOLDOWN_MS=30000
# Master switch: only explicit true allows the server or worker to contact inference.
INFERENCE_AI_ENABLED=true
# Enable chat only after the inference assistant provider and credentials are configured.
INFERENCE_ASSISTANT_ENABLED=false
# Skip article summaries, generated tags, and classification scores without calling inference.
SKIP_ARTICLE_CLASSIFICATION_ANALYSIS=false
# Skip article vector generation without calling inference.
SKIP_ARTICLE_EMBEDDINGS=false
# Skip generated event, topic, and island display labels without calling inference.
SKIP_SEMANTIC_LABELING=false
# HTTP/HTTPS configuration.
ENABLE_HTTPS=false
# Debugging and development flags.
EVENT_RECLUSTER_DEBUG=false
# Minimum cosine similarity required for recent article recommendations.
ARTICLE_RECOMMENDATION_MIN_SIMILARITY=0.64
# Recent vectorized articles considered per recommendation request (hard-capped at 600).
ARTICLE_RECOMMENDATION_MAX_CANDIDATES=600
# Optional Web Push notification configuration (VAPID).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

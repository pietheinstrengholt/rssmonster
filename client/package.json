{
  "name": "rssmonster-client",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "author": "Piethein Strengholt",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "generate:favicons": "node scripts/generate-favicons.js",
    "build": "npm run generate:favicons && vite build",
    "check:bootstrap-classes": "node scripts/check-bootstrap-classes.js",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "verify:build": "npm run check:bootstrap-classes && npm run build && npm run check:bundle-size",
    "preview": "vite preview --port 8080"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@dvuckovic/vue3-bootstrap-icons": "^2.0.0",
    "@vue/server-renderer": "^3.5.40",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootswatch": "^5.3.8",
    "js-cookie": "^3.0.8",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "baseline-browser-mapping": "^2.11.9",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "favicons": "^7.3.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "sass": "=1.102.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pietheinstrengholt/rssmonster"
  }
}
